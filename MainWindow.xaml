<Window x:Class="ADUMP.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ADUMP" Width="1040" Height="640" MinWidth="780" MinHeight="500"
    WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="28,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Click="ConfigurationButton_Click" VerticalAlignment="Center" Padding="15,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,8,0"/>
                        <TextBlock Text="Paramètres"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#3157C8" CornerRadius="10" Width="40" Height="40">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="ADUMP" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="ACTIVE DIRECTORY" Style="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,30,32,24" MaxWidth="1180">
                <TextBlock Text="ESPACE D’ADMINISTRATION" Style="{StaticResource Muted}" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Text="Tableau de bord" Style="{StaticResource PageTitle}" Margin="0,8,0,6"/>
                <TextBlock Text="Gérez vos comptes Active Directory depuis un espace unique." Style="{StaticResource Muted}"/>
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,24,0,26">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Configurer" Click="ConfigurationButton_Click" Padding="14,7" Margin="12,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="DOMAINE CONFIGURÉ" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DomainStatus" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock Text="Actions rapides" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="Importer un CSV" Click="ImportUsersButton_Click" Margin="0,22,0,0" Padding="10,9"/>
                            <StackPanel><TextBlock Text="&#xE898;" Style="{StaticResource Glyph}"/><TextBlock Text="Importer" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Créez plusieurs comptes à partir d’un fichier CSV." Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="Voir les utilisateurs" Click="ShowUsersButton_Click" Margin="0,22,0,0" Padding="10,9"/>
                            <StackPanel><TextBlock Text="&#xE716;" Style="{StaticResource Glyph}"/><TextBlock Text="Utilisateurs" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Consultez et recherchez les comptes du domaine." Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="Paramètres" Click="ConfigurationButton_Click" Margin="0,22,0,0" Padding="10,9"/>
                            <StackPanel><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}"/><TextBlock Text="Configuration" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Adaptez le domaine et le format de vos imports." Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="28,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Right" Text="Apparence Windows automatique" Style="{StaticResource Muted}" FontSize="12"/>
                <TextBlock Text="ADUMP  /  Version 2.0" Style="{StaticResource Muted}" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
