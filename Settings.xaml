<Window x:Class="ADUMP.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ADUMP — Paramètres" Width="600" Height="610" MinWidth="470" MinHeight="470"
    WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Configuration" Style="{StaticResource PageTitle}" Margin="0,0,0,6"/>
                <TextBlock Text="Personnalisez les paramètres de votre environnement." Style="{StaticResource Muted}"/>
                <Border Style="{StaticResource Card}" Margin="0,24,0,14">
                    <StackPanel>
                        <TextBlock Text="Active Directory" Style="{StaticResource SectionTitle}"/>
                        <Label Content="Nom de domaine DNS" Target="{Binding ElementName=DomainNameTextBox}" Padding="0,16,0,6"/>
                        <TextBox x:Name="DomainNameTextBox" MinHeight="36"/>
                        <TextBlock Text="Exemple : domaine.local" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                        <Label Content="Délimiteur CSV" Target="{Binding ElementName=DelimiterBox}" Padding="0,16,0,6"/>
                        <ComboBox x:Name="DelimiterBox" SelectedValuePath="Tag" MinHeight="36">
                            <ComboBoxItem Content="Virgule (,)" Tag="comma"/>
                            <ComboBoxItem Content="Point-virgule (;)" Tag="semicolon"/>
                            <ComboBoxItem Content="Tabulation" Tag="tab"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Apparence" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Suivre le système Windows" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <TextBlock Text="Le thème clair ou sombre s’applique automatiquement selon les paramètres Windows." Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="1" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Enregistrer" IsDefault="True" Click="SaveChangesButton_Click" Padding="20,9"/>
            <Button DockPanel.Dock="Right" Content="Annuler" IsCancel="True" Margin="0,0,10,0" Padding="16,9"/>
            <TextBlock Text="Version 2.0" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
