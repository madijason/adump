<Window x:Class="ADUMP.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres ADUMP" Height="450" Width="500" 
        Closing="Window_Closing"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="⚙️ Configuration" 
                          FontFamily="Segoe UI" 
                          FontSize="24" 
                          FontWeight="Light" 
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Paramètres de l'application" 
                          Style="{StaticResource CaptionStyle}" 
                          Foreground="#B3FFFFFF"
                          HorizontalAlignment="Center"
                          Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                <!-- Domain Configuration Card -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="🌐 Configuration du domaine" 
                                  Style="{StaticResource SubheadingStyle}"
                                  Margin="0,0,0,16"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                      Text="Nom de domaine:"
                                      Style="{StaticResource SubheadingStyle}"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,8"/>
                            <TextBox x:Name="DomainNameTextBox" 
                                    Grid.Row="0" Grid.Column="1"
                                    Style="{StaticResource ModernTextBoxStyle}"
                                    Margin="0,0,0,16"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                      Text="Délimiteur CSV:"
                                      Style="{StaticResource SubheadingStyle}"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,8"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" 
                                     Margin="0,0,0,16"
                                     FontFamily="Segoe UI"
                                     FontSize="14"
                                     Padding="12,8">
                                <ComboBoxItem Content="Virgule (,)"/>
                                <ComboBoxItem Content="Point-virgule (;)"/>
                                <ComboBoxItem Content="Tabulation (\t)"/>
                            </ComboBox>
                        </Grid>
                        
                        <Button Content="💾 Enregistrer les modifications"
                               Style="{StaticResource ModernButtonStyle}"
                               Click="SaveChangesButton_Click"
                               HorizontalAlignment="Center"
                               Width="250"
                               Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Application Actions Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="🔧 Actions de l'application" 
                                  Style="{StaticResource SubheadingStyle}"
                                  Margin="0,0,0,16"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="🐛 Signaler un bug" 
                                   Style="{StaticResource ModernButtonStyle}"
                                   Background="{StaticResource AccentBrush}"
                                   Width="150"
                                   Margin="8"/>
                            <Button Content="🔄 Mettre à jour" 
                                   Style="{StaticResource ModernButtonStyle}"
                                   Background="#4CAF50"
                                   Width="150"
                                   Margin="8"/>
                        </StackPanel>
                        
                        <TextBlock Text="💡 Astuce: Assurez-vous que le nom de domaine est correct avant d'enregistrer"
                                  Style="{StaticResource CaptionStyle}"
                                  TextWrapping="Wrap"
                                  HorizontalAlignment="Center"
                                  Margin="0,16,0,0"
                                  Background="#FFF3E0"
                                  Padding="12,8"
                                  Foreground="#F57C00"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer -->
        <Border Grid.Row="2" Background="#FAFAFA" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Version 1.0" Style="{StaticResource CaptionStyle}"/>
                <TextBlock Text=" • " Style="{StaticResource CaptionStyle}" Margin="8,0"/>
                <TextBlock Text="Configuration ADUMP" Style="{StaticResource CaptionStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>